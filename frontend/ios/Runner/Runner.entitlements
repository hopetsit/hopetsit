<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- v413 — Daniel : "pas de notification push sur iPhone alors que c'est
	     activé". CAUSE : l'entitlement `aps-environment` était ABSENTE → iOS
	     refuse d'enregistrer l'app pour les notifications distantes (APNs), donc
	     FCM ne peut RIEN livrer sur iPhone (Android n'a pas besoin de ça → il
	     marchait). On l'ajoute. Avec "Automatically manage signing" dans Xcode,
	     la valeur 'development' est promue en 'production' au moment de l'archive
	     de distribution (TestFlight/App Store). ⚠️ Il faut AUSSI : (1) cocher la
	     capability "Push Notifications" dans Xcode (Signing & Capabilities), et
	     (2) uploader la clé d'authentification APNs (.p8) dans Firebase Console
	     → Project settings → Cloud Messaging → Apple app configuration. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- v23.1 part 146 — Universal Links iOS.
	     Quand l'utilisateur tape sur un lien `https://hopetsit.com/pay/xxx`
	     depuis Safari, Mail, WhatsApp etc., iOS vérifie le fichier
	     `apple-app-site-association` hébergé sur le domaine et, s'il
	     autorise l'AppID J7259479JR.com.hopetsit.app, ouvre directement
	     l'app au lieu de Safari.
	     Doit être lié au target Runner via Xcode :
	       Xcode → Runner → Signing & Capabilities → + Capability
	       → Associated Domains → Add `applinks:hopetsit.com` etc.
	     (Le simple fait que le fichier .entitlements existe ne suffit pas,
	     il faut aussi que `CODE_SIGN_ENTITLEMENTS = Runner/Runner.entitlements`
	     soit dans le project.pbxproj — Xcode l'ajoute automatiquement
	     quand on coche "Associated Domains" via l'UI.) -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:hopetsit.com</string>
		<string>applinks:www.hopetsit.com</string>
		<string>applinks:app.hopetsit.com</string>
	</array>
</dict>
</plist>
