<?xml version="1.0" encoding="utf-8"?>
<!-- v570 — Android 12+ (API 31) : l'écran de démarrage est géré par le
     système (SplashScreen API) et ignore windowBackground. On impose donc
     l'aplat #DD4430 + une icône transparente pour n'afficher QUE la couleur.
     ⚠️ Le qualificateur `night` a priorité sur `v31` : d'où le jumeau
     values-night-v31/styles.xml. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_transparent</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/dark_window_bg</item>
    </style>
</resources>
